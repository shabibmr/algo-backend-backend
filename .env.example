PORT=5000
# Host port for MariaDB. Leave empty so the DB stays on the Docker network only.
DB_PORT=
NODE_ENV=development
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/algoerp_dev"
JWT_ACCESS_SECRET="replace-with-at-least-16-chars"
JWT_REFRESH_SECRET="replace-with-at-least-16-chars"
LOG_TO_FILE=false
