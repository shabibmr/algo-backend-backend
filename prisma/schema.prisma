generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model account_groups {
  id                   Int              @id @default(autoincrement())
  group_code           String?          @db.VarChar(50)
  parent_group_id      Int?
  Group_Name           String           @db.VarChar(50)
  is_system_defined    Boolean          @default(false)
  created_at           DateTime         @default(now()) @db.Timestamp(0)
  updated_at           DateTime?        @db.Timestamp(0)
  account_groups       account_groups?  @relation("account_groupsToaccount_groups", fields: [parent_group_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_group_parent")
  other_account_groups account_groups[] @relation("account_groupsToaccount_groups")
  ledger_master        ledger_master[]

  @@index([parent_group_id], map: "fk_group_parent")
}

model address_book {
  id                                                        Int                       @id @default(autoincrement())
  contact_type                                              address_book_contact_type @default(INDIVIDUAL)
  Address_Id                                                String                    @db.VarChar(500)
  Name                                                      String?                   @db.VarChar(1000)
  Designation                                               String?                   @db.VarChar(500)
  Company_Name                                              String?                   @db.VarChar(500)
  Email                                                     String?                   @db.VarChar(500)
  Ledger                                                    String?                   @db.VarChar(1000)
  Narration                                                 String?                   @db.VarChar(1000)
  TimeStamp                                                 DateTime?                 @default(now()) @db.DateTime(0)
  Building                                                  String?                   @db.VarChar(500)
  Street                                                    String?                   @db.VarChar(500)
  City                                                      String?                   @db.VarChar(500)
  Country                                                   String?                   @db.VarChar(500)
  POBox                                                     String?                   @db.VarChar(100)
  Phone_Number                                              String?                   @db.VarChar(100)
  Mobile_Number                                             String?                   @db.VarChar(100)
  Location                                                  String?                   @db.VarChar(1000)
  Address                                                   String?                   @db.VarChar(1000)
  Fax                                                       String?                   @db.VarChar(100)
  Location_Details                                          String?                   @db.LongText
  Route                                                     String?                   @db.VarChar(20)
  CustomerCode                                              String?                   @db.VarChar(20)
  DateOfBirth                                               DateTime?                 @db.Date
  Contact_Uuid                                              String?                   @db.VarChar(100)
  isActive                                                  Boolean?                  @default(false)
  Delivery_Charges                                          Float?                    @db.Float
  employee_details                                          employee_details?
  ledger_master                                             ledger_master[]
  project_master                                            project_master[]
  user_credentials                                          user_credentials?
  vehicle_log_vehicle_log_driver_contact_idToaddress_book   vehicle_log[]             @relation("vehicle_log_driver_contact_idToaddress_book")
  vehicle_log_vehicle_log_shipping_company_idToaddress_book vehicle_log[]             @relation("vehicle_log_shipping_company_idToaddress_book")
  vehilce_master                                            vehilce_master[]
}

model attendance_details {
  id                     Int                       @id @default(autoincrement())
  attendance_employee_id Int?
  working_date           DateTime?                 @db.Date
  check_in_time          DateTime?                 @db.DateTime(0)
  check_out_time         DateTime?                 @db.DateTime(0)
  Employee_Id            String                    @db.VarChar(20)
  Working_Day            DateTime                  @db.Date
  Start_Time             DateTime                  @default(now()) @db.Timestamp(0)
  End_Time               DateTime?                 @db.Timestamp(0)
  Working_Hours          Int
  overtime_hours         Decimal                   @default(0.00) @db.Decimal(5, 2)
  status                 attendance_details_status @default(PRESENT)
  OverTime               Int
  HalfDay                Boolean
  Narration              String?                   @db.VarChar(200)
  employee_details       employee_details?         @relation(fields: [attendance_employee_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_attendance_employee")
  leave_request_id       Int?
  leave_request          leaverequest?             @relation(fields: [leave_request_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_att_leaverequest")

  @@index([attendance_employee_id], map: "fk_attendance_employee")
  @@index([leave_request_id], map: "fk_att_leaverequest")
}

model billwise_records {
  id            Int       @id @default(autoincrement()) @map("_id")
  voucherPrefix String?   @db.VarChar(50)
  VoucherType   String?   @db.VarChar(200)
  VoucherNo     String?   @db.VarChar(200)
  LedgerID      String?   @db.VarChar(200)
  RefType       String?   @db.VarChar(50)
  RefNo         String?   @db.VarChar(200)
  RefPrefix     String?   @db.VarChar(200)
  DebitAmount   Float?    @db.Float
  CreditAmount  Float?    @db.Float
  VoucherDate   DateTime? @db.DateTime(0)
  Method_of_adj String?   @db.VarChar(100)
  Due_Date      DateTime? @db.Date
  Salesman_ID   Int?
}

model boq_table {
  id                Int     @id @default(autoincrement()) @map("_id")
  Item_ID           String  @db.VarChar(100)
  Item_Qty          Float?  @db.Float
